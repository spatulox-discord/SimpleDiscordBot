{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    // "types": ["node"], // For typescript ^6.0.0
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,

    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "stripInternal": true,
    "declarationMap": true,

    /*need for "replaceAll" for example*/
    "lib": ["es2022"],

    /*JSON*/
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    /*Liting*/
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true

  },
  "exclude": ["src_example", "tsup.config.ts"]
}
